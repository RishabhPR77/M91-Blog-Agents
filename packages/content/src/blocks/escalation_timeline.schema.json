{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "escalation_timeline block data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "steps"
  ],
  "properties": {
    "steps": {
      "type": "array",
      "minItems": 2,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "markdown"
        ],
        "properties": {
          "markdown": {
            "type": "string",
            "minLength": 1,
            "description": "Markdown sliced from the approved post"
          }
        }
      }
    }
  },
  "description": "One ordered list of what happens over time."
}
