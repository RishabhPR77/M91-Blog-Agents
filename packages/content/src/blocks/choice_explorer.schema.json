{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "choice_explorer block data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "options"
  ],
  "properties": {
    "options": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "choice_markdown",
          "outcome_markdown"
        ],
        "properties": {
          "choice_markdown": {
            "type": "string",
            "minLength": 1,
            "description": "Markdown sliced from the approved post"
          },
          "outcome_markdown": {
            "type": "string",
            "minLength": 1,
            "description": "Markdown sliced from the approved post"
          }
        }
      }
    }
  },
  "description": "2–4 paragraphs that start with bold text (the choice)."
}
