{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "phone_ring_sim block data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "moments"
  ],
  "properties": {
    "moments": {
      "type": "array",
      "minItems": 3,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "actor",
          "markdown"
        ],
        "properties": {
          "actor": {
            "enum": [
              "agent",
              "m91",
              "phone",
              "human",
              "software"
            ]
          },
          "markdown": {
            "type": "string",
            "minLength": 1,
            "description": "Markdown sliced from the approved post"
          }
        }
      }
    }
  },
  "description": "One ordered list of 3–8 moments of the approval flow, one actor each."
}
