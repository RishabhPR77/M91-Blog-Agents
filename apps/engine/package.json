{
  "name": "@m91/engine",
  "version": "0.2.0",
  "private": true,
  "description": "M91 Blog Engine: agents, orchestrator, API and (later) dashboard",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.js\" && npm --prefix dashboard run test:unit",
    "test:node": "node --test \"test/**/*.test.js\"",
    "dev": "concurrently -k -n api,ui -c blue,magenta \"npm:dev:api\" \"npm:dev:ui\"",
    "dev:api": "node --watch --env-file=../../.env src/server.js",
    "dev:ui": "node --env-file=../../.env dashboard/scripts/dev.mjs",
    "build:dashboard": "npm --prefix dashboard run build",
    "install:dashboard": "npm --prefix dashboard ci",
    "start": "node src/server.js",
    "start:local": "node --env-file=../../.env src/server.js",
    "check": "node viasocket-check.mjs src",
    "smoke": "node --env-file=../../.env smoke/run.js",
    "pipeline": "node --env-file=../../.env src/cli.js",
    "pipeline:dry": "cross-env DRY_RUN=true node --env-file=../../.env src/cli.js",
    "pipeline:lite": "cross-env DRY_RUN=true SCOUT_QUESTION_GROUPS=1 SCOUT_QUESTIONS_PER_GROUP=3 DOCS_MAX_CHARS=15000 DOCS_MAX_PAGES=5 SCOUT_MAX_CALLS=6 AI_MAX_RETRIES=1 node --env-file=../../.env src/cli.js",
    "scout": "node --env-file=../../.env src/cli.js scout",
    "scout:dry": "cross-env DRY_RUN=true node --env-file=../../.env src/cli.js scout",
    "scout:lite": "cross-env DRY_RUN=true SCOUT_QUESTION_GROUPS=1 SCOUT_QUESTIONS_PER_GROUP=3 DOCS_MAX_CHARS=15000 DOCS_MAX_PAGES=5 SCOUT_MAX_CALLS=6 AI_MAX_RETRIES=1 node --env-file=../../.env src/cli.js scout",
    "scout:lite:live": "cross-env DRY_RUN=false SCOUT_QUESTION_GROUPS=1 SCOUT_QUESTIONS_PER_GROUP=3 DOCS_MAX_CHARS=15000 DOCS_MAX_PAGES=5 SCOUT_MAX_CALLS=6 AI_MAX_RETRIES=1 SCOUT_MIN_OPEN_CLUSTERS=1 node --env-file=../../.env src/cli.js scout",
    "strategist": "node --env-file=../../.env src/cli.js strategist",
    "strategist:dry": "cross-env DRY_RUN=true node --env-file=../../.env src/cli.js strategist",
    "brief": "node --env-file=../../.env src/cli.js brief",
    "pin": "node --env-file=../../.env src/cli.js pin",
    "writer": "node --env-file=../../.env src/cli.js writer",
    "writer:dry": "cross-env DRY_RUN=true node --env-file=../../.env src/cli.js writer",
    "draft": "node --env-file=../../.env src/cli.js draft",
    "checks": "node --env-file=../../.env src/cli.js checks",
    "cleanup": "node --env-file=../../.env src/cli.js cleanup",
    "lessons": "node --env-file=../../.env src/cli.js lessons",
    "reviewer": "node --env-file=../../.env src/cli.js reviewer",
    "reviewer:dry": "cross-env DRY_RUN=true node --env-file=../../.env src/cli.js reviewer",
    "promo": "node --env-file=../../.env src/cli.js promo",
    "designer": "node --env-file=../../.env src/cli.js designer",
    "approvals": "node --env-file=../../.env src/cli.js approvals",
    "approve": "node --env-file=../../.env src/cli.js approve",
    "revise": "node --env-file=../../.env src/cli.js revise",
    "reject": "node --env-file=../../.env src/cli.js reject",
    "review": "node --env-file=../../.env src/cli.js review",
    "test:await": "node --env-file=../../.env src/cli.js test-await",
    "publish": "node --env-file=../../.env src/cli.js publish",
    "unpublish": "node --env-file=../../.env src/cli.js unpublish",
    "set-index": "node --env-file=../../.env src/cli.js set-index",
    "rebuild-blog": "node --env-file=../../.env src/cli.js rebuild-blog",
    "blog:sync": "node --env-file=../../.env src/cli.js blog-sync",
    "mem0:usage": "node --env-file=../../.env src/cli.js mem0-usage",
    "reset:all": "node --env-file=../../.env src/cli.js reset",
    "roadmap": "node --env-file=../../.env src/cli.js roadmap",
    "export": "node --env-file=../../.env src/cli.js export",
    "timely": "node --env-file=../../.env src/cli.js timely",
    "admin:hash": "node scripts/admin-hash.mjs",
    "package:embarko": "node scripts/package-embarko.mjs",
    "deploy:embarko": "node --env-file=../../.env scripts/deploy-embarko.mjs",
    "embarko:env": "node scripts/embarko-env.mjs",
    "embarko:env-sync": "node --env-file=../../.env scripts/embarko-env-sync.mjs",
    "embarko": "node --env-file=../../.env scripts/embarko-api.mjs"
  },
  "dependencies": {
    "@m91/content": "0.1.0",
    "ajv": "8.18.0",
    "mem0ai": "3.3.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "viasocket-apps": "0.11.0"
  },
  "devDependencies": {
    "concurrently": "9.2.4",
    "cross-env": "7.0.3"
  }
}
