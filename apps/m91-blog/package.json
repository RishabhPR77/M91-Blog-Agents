{
  "name": "m91-blog",
  "version": "1.0.0",
  "private": true,
  "description": "The M91 blog (m91-blog.embarko.app): every approved post from the M91 Blog Engine, in the look of m91.msg91.com",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
