{
  "name": "@m91/blog",
  "version": "0.1.0",
  "private": true,
  "description": "The M91 blog: a static Astro site built from the post JSON files the engine's Publisher writes",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/astro.mjs dev --port 4321",
    "build": "node scripts/astro.mjs build",
    "preview": "node scripts/astro.mjs preview --port 4321",
    "check": "node scripts/astro.mjs check && npm test",
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@m91/content": "file:../../packages/content",
    "@resvg/resvg-js": "2.6.2",
    "@shikijs/rehype": "4.5.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.5",
    "rehype-autolink-headings": "7.1.0",
    "rehype-external-links": "3.0.0",
    "rehype-slug": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "satori": "0.35.0",
    "shiki": "4.5.0",
    "tailwindcss": "4.3.3",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "6.0.3"
  },
  "overrides": {
    "fflate": "0.7.5"
  }
}
