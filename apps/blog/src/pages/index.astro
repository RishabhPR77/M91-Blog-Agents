---
// The blog home: the M91 site's blog section, on ruled paper. Eyebrow, heading and search on top, then every
// indexed post as a lime card. Search filters the cards in the page (no request, no topic pages); without
// JavaScript every post is listed and the search box is hidden.
import BaseLayout from '../layouts/BaseLayout.astro'
import PostCard from '../components/PostCard.astro'
import { indexedPosts } from '../lib/posts'
import { blogLd } from '../lib/seo'
import { SITE, HOME } from '../config/site'

const posts = indexedPosts()
---
<BaseLayout title={SITE.title} description={SITE.description} path="/" jsonLd={[blogLd(posts)]}>
  <section class="ruled pb-20 pt-14 md:pb-24 md:pt-20">
    <div class="wide">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="eyebrow">{HOME.eyebrow}</p>
          <h1 class="h-display mt-6">{HOME.title}</h1>
        </div>
        <label class="search js-only" for="post-search">
          <span class="sr-only">Search the blog</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
          <input id="post-search" type="search" placeholder="Search posts" autocomplete="off" spellcheck="false" aria-controls="post-grid" />
        </label>
      </div>
      {posts.length === 0 ? (
        <p class="bl-empty mt-10">No posts yet.</p>
      ) : (
        <>
          <div id="post-grid" class="bl-grid mt-10">
            {posts.map((p) => <PostCard post={p} />)}
          </div>
          <p class="bl-empty mt-10" data-no-results hidden>No posts match “<span data-query></span>”.</p>
          <p class="sr-only" role="status" aria-live="polite" data-search-status></p>
        </>
      )}
    </div>
  </section>
</BaseLayout>

<script>
  // Filters the cards by every word typed (title, description, topic and tags). ?q= in the URL fills the box.
  const input = document.querySelector<HTMLInputElement>('#post-search')
  const cards = [...document.querySelectorAll<HTMLElement>('#post-grid > [data-search]')]
  const empty = document.querySelector<HTMLElement>('[data-no-results]')
  const query = document.querySelector<HTMLElement>('[data-query]')
  const status = document.querySelector<HTMLElement>('[data-search-status]')
  function apply() {
    if (!input) return
    const words = input.value.toLowerCase().split(/\s+/).filter(Boolean)
    let shown = 0
    for (const card of cards) {
      const hit = words.every((w) => (card.dataset.search ?? '').includes(w))
      card.hidden = !hit
      if (hit) shown++
    }
    if (empty) empty.hidden = shown > 0 || cards.length === 0
    if (query) query.textContent = input.value.trim()
    if (status) status.textContent = words.length ? `${shown} post${shown === 1 ? '' : 's'} found` : ''
  }
  if (input) {
    const q = new URLSearchParams(location.search).get('q')
    if (q) input.value = q
    input.addEventListener('input', apply)
    apply()
  }
</script>
