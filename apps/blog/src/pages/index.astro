---
import BaseLayout from '../layouts/BaseLayout.astro'
import TopicChips from '../components/TopicChips.astro'
import PostList from '../components/PostList.astro'
import { indexedPosts } from '../lib/posts'
import { blogLd } from '../lib/seo'
import { SITE, POSTS_PER_PAGE } from '../config/site'

const posts = indexedPosts()
const pages = Math.max(1, Math.ceil(posts.length / POSTS_PER_PAGE))
---
<BaseLayout title={SITE.title} description={SITE.description} path="/" jsonLd={[blogLd(posts)]}>
  <div class="shell py-12">
    <h1 class="text-4xl font-bold tracking-tight md:text-5xl">The M91 blog</h1>
    <p class="mt-4 max-w-2xl text-lg text-fg-2">{SITE.description}</p>
    <div class="mt-8"><TopicChips /></div>
    <div class="mt-10"><PostList posts={posts.slice(0, POSTS_PER_PAGE)} page={1} pages={pages} featureFirst /></div>
  </div>
</BaseLayout>
