---
// One guide (Phase 10, A3): breadcrumb, "Guide" label, title, description, byline and share; the hero scene;
// takeaways.log; the numbered chapters (blocks or Markdown) with the sticky rail beside them (or the chapter
// bar on narrow screens); sources; the end strip (written by … questions answered), "Your turn", share and
// "Keep reading". Old posts render in this same shell.
import BaseLayout from './BaseLayout.astro'
import StoryScene from '../components/guide/StoryScene.astro'
import TakeawaysLog from '../components/guide/TakeawaysLog.astro'
import GuideRail from '../components/guide/GuideRail.astro'
import EndMeta from '../components/guide/EndMeta.astro'
import PromptStrip from '../components/PromptStrip.astro'
import BlockRenderer from '../components/BlockRenderer.astro'
import CodeCopy from '../components/CodeCopy.astro'
import SourcesList from '../components/SourcesList.astro'
import RelatedPosts from '../components/RelatedPosts.astro'
import ShareLinks from '../components/ShareLinks.astro'
import type { Post } from '../lib/posts'
import { topicOf, relatedPosts, formatDate, url } from '../lib/posts'
import { renderMarkdown } from '../lib/markdown'
import { chaptersOf, stuckChapter, questionCount, DEFAULT_STATES } from '../lib/chapters'
import { blogPostingLd, breadcrumbLd } from '../lib/seo'
import { SITE } from '../config/site'

interface Props { post: Post }
const { post } = Astro.props
const topic = topicOf(post)
const { html, headings } = await renderMarkdown(post.markdown)
const states = DEFAULT_STATES
const chapters = chaptersOf(headings, states)
const stuck = stuckChapter(chapters)
const updated = post.updated_at.slice(0, 10) !== post.published_at.slice(0, 10)
---
<BaseLayout
  title={post.seo.title_tag || post.title}
  description={post.seo.meta_description || post.description}
  path={`/posts/${post.slug}/`}
  canonical={post.canonical_url}
  ogImage={post.seo.og_image}
  ogType="article"
  noindex={post.noindex}
  jsonLd={[blogPostingLd(post), breadcrumbLd(post)]}
  footerCta={false}
>
  <div class="g-wrap gp-top">
    <div class="gp-grid">
      <article class="gp-main">
        <nav aria-label="Breadcrumb" class="gp-crumbs">
          <a href={url('/')}>Guides</a><span aria-hidden="true">/</span>
          <a href={url(`/?topic=${topic.group}`)}>{topic.short}</a><span aria-hidden="true">/</span>
          <span aria-current="page" class="sr-only">{post.title}</span>
        </nav>
        <header class="gp-hero">
          <p class="flex flex-wrap items-center gap-2"><span class="tag-lime">Guide</span><span class="mono-k">{topic.short} · {post.reading_time_min} min read</span></p>
          <h1 class="gp-h1">{post.title}</h1>
          <p class="gp-desc">{post.description}</p>
          <div class="gp-by">
            <span class="gp-by-who"><span class="gc-av" aria-hidden="true">M</span>{SITE.author}</span>
            <span>{updated ? 'Updated' : 'Published'} <time datetime={updated ? post.updated_at : post.published_at}>{formatDate(updated ? post.updated_at : post.published_at)}</time></span>
            <button type="button" class="pill js-only" data-copy-link={post.canonical_url}>Share</button>
          </div>
        </header>
        <StoryScene />
        <TakeawaysLog items={post.tldr} />
        <GuideRail chapters={chapters} states={states} stuck={stuck} place="bar" />
        <div class="gp-body">
          {post.blocks
            ? <BlockRenderer blocks={post.blocks} slug={post.slug} headingIds={headings.map((h) => h.id)} fallbackHtml={html} />
            : <div class="prose-m91" set:html={html} />}
          <CodeCopy />
        </div>
        <div class="gp-end">
          <SourcesList sources={post.sources} />
          <EndMeta published={post.published_at} updated={post.updated_at} minutes={post.reading_time_min} questions={questionCount(headings)} />
          <PromptStrip id="your-turn" label="Your turn" title="Let your agent ask before it acts." />
          <ShareLinks url={post.canonical_url} title={post.title} />
        </div>
      </article>
      <GuideRail chapters={chapters} states={states} stuck={stuck} place="rail" />
    </div>
    <div class="gp-related">
      <RelatedPosts posts={relatedPosts(post)} />
    </div>
  </div>
</BaseLayout>
