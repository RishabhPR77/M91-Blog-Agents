---
// One post: breadcrumbs, title, meta line, TL;DR, contents, body (blocks or Markdown), CTA, sources,
// related posts and share links.
import BaseLayout from './BaseLayout.astro'
import TLDR from '../components/TLDR.astro'
import TableOfContents from '../components/TableOfContents.astro'
import BlockRenderer from '../components/BlockRenderer.astro'
import CodeCopy from '../components/CodeCopy.astro'
import CtaPanel from '../components/CtaPanel.astro'
import SourcesList from '../components/SourcesList.astro'
import RelatedPosts from '../components/RelatedPosts.astro'
import ShareLinks from '../components/ShareLinks.astro'
import type { Post } from '../lib/posts'
import { topicOf, relatedPosts, formatDate, url } from '../lib/posts'
import { renderMarkdown } from '../lib/markdown'
import { blogPostingLd, breadcrumbLd } from '../lib/seo'
import { SITE } from '../config/site'

interface Props { post: Post }
const { post } = Astro.props
const topic = topicOf(post)
const { html, headings } = await renderMarkdown(post.markdown)
const updated = post.updated_at.slice(0, 10) !== post.published_at.slice(0, 10)
---
<BaseLayout
  title={post.seo.title_tag || post.title}
  description={post.seo.meta_description || post.description}
  path={`/posts/${post.slug}/`}
  canonical={post.canonical_url}
  ogImage={post.seo.og_image}
  ogType="article"
  noindex={post.noindex}
  jsonLd={[blogPostingLd(post), breadcrumbLd(post)]}
>
  <article class="shell py-10">
    <nav aria-label="Breadcrumb" class="text-sm text-fg-2">
      <ol class="flex flex-wrap items-center gap-2">
        <li><a href={url('/')} class="hover:underline">Blog</a></li>
        <li aria-hidden="true">›</li>
        <li><a href={url(`/topics/${topic.slug}/`)} class="hover:underline">{topic.name}</a></li>
        <li aria-hidden="true">›</li>
        <li aria-current="page" class="truncate text-fg">{post.title}</li>
      </ol>
    </nav>
    <header class="mt-6 max-w-3xl">
      <h1 class="text-4xl font-bold leading-tight tracking-tight md:text-5xl">{post.title}</h1>
      <p class="mt-4 text-xl text-fg-2">{post.description}</p>
      <p class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-fg-2">
        <span>Published <time datetime={post.published_at}>{formatDate(post.published_at)}</time></span>
        {updated && <span>· Updated <time datetime={post.updated_at}>{formatDate(post.updated_at)}</time></span>}
        <span>· {post.reading_time_min} min read</span>
        <a href={url(`/topics/${topic.slug}/`)} class="chip">{topic.short}</a>
        <span>· {SITE.author}</span>
      </p>
    </header>
    <div class="mt-8 max-w-[44rem] space-y-6">
      <TLDR items={post.tldr} />
      <TableOfContents headings={headings} />
    </div>
    <div class="mt-10">
      {post.blocks
        ? <BlockRenderer blocks={post.blocks} slug={post.slug} headingIds={headings.map((h) => h.id)} fallbackHtml={html} />
        : <div class="prose-m91" set:html={html} />}
      <CodeCopy />
    </div>
    <div class="mt-14 max-w-[44rem] space-y-12">
      <CtaPanel />
      <SourcesList sources={post.sources} />
      <ShareLinks url={post.canonical_url} title={post.title} />
    </div>
    <div class="mt-14">
      <RelatedPosts posts={relatedPosts(post)} />
    </div>
  </article>
</BaseLayout>
