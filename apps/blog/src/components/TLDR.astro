---
interface Props { items: string[] }
const { items } = Astro.props
---
<aside class="rounded-2xl border border-line bg-bg-warm p-6" aria-labelledby="tldr-title">
  <h2 id="tldr-title" class="text-sm font-bold uppercase tracking-wider text-fg-2">TL;DR</h2>
  <ul class="mt-3 space-y-2 text-lg leading-relaxed">
    {items.map((item) => (
      <li class="flex gap-3"><span class="mt-2.5 h-2 w-2 shrink-0 bg-mark" aria-hidden="true"></span><span>{item}</span></li>
    ))}
  </ul>
</aside>
