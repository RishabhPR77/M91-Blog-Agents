---
// The M91 site's masthead: logo, the pill nav (Blog is this site), and "Download the app". The download
// menu is a <details> element, so it opens without JavaScript.
import Logo from './Logo.astro'
import { M91_URL, M91_LINKS } from '../config/site'
import { url } from '../lib/posts'
const links = [
  { href: M91_LINKS.how, label: 'How it works', extra: true },
  { href: M91_LINKS.cases, label: 'Use cases', extra: true },
  { href: M91_LINKS.features, label: 'Features', extra: true },
  { href: M91_LINKS.integrations, label: 'Integrations', extra: true },
  { href: M91_LINKS.pricing, label: 'Pricing', extra: false },
  { href: url('/'), label: 'Blog', current: true, extra: false },
  { href: M91_LINKS.docs, label: 'Docs', extra: false }
]
---
<header class="masthead">
  <div class="wide masthead-in">
    <a href={M91_URL} class="logo" aria-label="M91 home">
      <Logo size={36} />
      <span class="logo-word">M91</span>
    </a>
    <nav class="nav" aria-label="Main">
      {links.map((l) => (
        <a href={l.href} class:list={['nav-link', l.extra && 'nav-extra']} aria-current={l.current ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
    <details class="dl">
      <summary class="btn"><span>Download<span class="dl-opt"> the app</span></span></summary>
      <div class="dl-menu">
        <a class="dl-item" href={M91_LINKS.appStore} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.05 12.54a4.4 4.4 0 0 1 2.1-3.7 4.52 4.52 0 0 0-3.56-1.92c-1.5-.15-2.93.88-3.69.88-.77 0-1.94-.86-3.2-.84a4.73 4.73 0 0 0-3.98 2.42c-1.7 2.95-.43 7.31 1.22 9.71.81 1.17 1.78 2.49 3.05 2.44 1.22-.05 1.68-.79 3.16-.79 1.47 0 1.89.79 3.18.76 1.31-.02 2.14-1.19 2.94-2.37a10.6 10.6 0 0 0 1.34-2.74 4.27 4.27 0 0 1-2.56-3.85z"></path><path d="M14.6 5.3a4.33 4.33 0 0 0 1-3.1 4.41 4.41 0 0 0-2.9 1.5 4.13 4.13 0 0 0-1.03 3 3.65 3.65 0 0 0 2.93-1.4z"></path></svg>
          Download on the App Store
        </a>
        <a class="dl-item" href={M91_LINKS.googlePlay} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.61 1.81a2.01 2.01 0 0 0-.61 1.43v17.52c0 .56.23 1.06.61 1.43L13.79 12 3.61 1.81z" fill="#00A0FF"></path><path d="M17.14 15.34 13.79 12l3.35-3.34 4 2.27c1.14.65 1.14 1.79 0 2.44l-4 2.27z" fill="#FFCE00"></path><path d="M17.14 15.34 13.79 12 3.61 22.19c.38.4 1 .45 1.7.05l11.83-6.9z" fill="#FF3A44"></path><path d="M17.14 8.66 5.31 1.76c-.7-.4-1.32-.35-1.7.05L13.79 12l3.35-3.34z" fill="#00D267"></path></svg>
          Get it on Google Play
        </a>
      </div>
    </details>
  </div>
</header>
