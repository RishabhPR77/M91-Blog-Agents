---
// One post as the M91 site's lime card: topic label, title (the whole card is the link), description, and
// the reading time and date. data-search holds the text the home page's search matches.
import type { Post } from '../lib/posts'
import { topicOf, formatDate, url } from '../lib/posts'
interface Props { post: Post; headingLevel?: 2 | 3 }
const { post, headingLevel = 2 } = Astro.props
const topic = topicOf(post)
const link = url(`/posts/${post.slug}/`)
const search = [post.title, post.description, topic.name, ...post.tags].join(' ').toLowerCase()
---
<article class="bl-card" data-search={search}>
  <span class="bl-k">{topic.short}</span>
  {headingLevel === 2
    ? <h2 class="bl-t"><a href={link}>{post.title}</a></h2>
    : <h3 class="bl-t"><a href={link}>{post.title}</a></h3>}
  <p class="bl-p">{post.description}</p>
  <p class="bl-m"><span>{post.reading_time_min} min read</span><span aria-hidden="true">·</span><time datetime={post.published_at}>{formatDate(post.published_at)}</time></p>
</article>
