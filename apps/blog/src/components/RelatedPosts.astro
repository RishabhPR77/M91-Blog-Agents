---
// "Keep reading": up to three related guides as numbered-less cards.
import GuideCard from './GuideCard.astro'
import type { Post } from '../lib/posts'
interface Props { posts: Post[] }
const { posts } = Astro.props
---
{posts.length > 0 && (
  <section aria-labelledby="related-title">
    <p class="gh-group"><span class="mono-k">Keep reading</span><span id="related-title" class="gh-group-t">More guides like this one</span></p>
    <div class="gh-grid">
      {posts.map((p) => <GuideCard post={p} headingLevel={3} />)}
    </div>
  </section>
)}
