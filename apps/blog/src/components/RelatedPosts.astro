---
import PostCard from './PostCard.astro'
import type { Post } from '../lib/posts'
interface Props { posts: Post[] }
const { posts } = Astro.props
---
{posts.length > 0 && (
  <section aria-labelledby="related-title">
    <h2 id="related-title" class="text-2xl font-extrabold tracking-[-0.03em]">Related posts</h2>
    <div class="bl-grid mt-6">
      {posts.map((p) => <PostCard post={p} headingLevel={3} />)}
    </div>
  </section>
)}
