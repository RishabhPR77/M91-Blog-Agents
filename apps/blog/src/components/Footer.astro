---
// The M91 site's closing call to action ("Copy setup prompt") and its footer panel, with the site's links.
// The copy button needs JavaScript; without it, a link to the setup guide (llms.txt) shows instead.
import Logo from './Logo.astro'
import { M91_URL, M91_LINKS, SETUP_PROMPT } from '../config/site'
import { url } from '../lib/posts'
const year = new Date().getFullYear()
const product = [
  { href: M91_LINKS.how, label: 'How it works' },
  { href: M91_LINKS.cases, label: 'Use cases' },
  { href: M91_LINKS.features, label: 'Features' },
  { href: M91_LINKS.pricing, label: 'Pricing' },
  { href: url('/'), label: 'Blog' }
]
const ext = { target: '_blank', rel: 'noopener' }
---
<section class="cta-band" aria-labelledby="cta-title">
  <div class="wide">
    <h2 id="cta-title" class="cta-h">Give your software a way<br />to get human approval<span class="dot">.</span></h2>
    <p class="cta-sub">Your software sends the alert. M91 finds the human. They answer. Work carries on.</p>
    <div class="cta-btns">
      <button type="button" class="cta-card js-only" data-copy-prompt={SETUP_PROMPT}>
        <span class="cta-chip" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="12" height="12"></rect><path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1"></path></svg></span>
        <span>
          <span class="cta-card-t" data-copy-label>Copy setup prompt</span>
          <span class="cta-card-s">Paste it to your LLM</span>
        </span>
      </button>
      <a class="cta-card no-js-only" href={M91_LINKS.llms} {...ext}>
        <span class="cta-chip" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></span>
        <span>
          <span class="cta-card-t">Read the setup guide</span>
          <span class="cta-card-s">llms.txt, for your LLM</span>
        </span>
      </a>
    </div>
    <p class="cta-note">Free forever · Built by MSG91</p>
  </div>
</section>
<footer class="foot">
  <div class="wide">
    <div class="foot-panel">
      <div class="foot-top">
        <div class="foot-brand">
          <a href={M91_URL} class="foot-l" aria-label="M91 home"><Logo size={26} /><span class="foot-w">M91</span></a>
          <p class="foot-line">Alerts that reach a real human and keep going until somebody answers.</p>
          <span class="foot-apps">
            <a class="foot-app" href={M91_LINKS.appStore} {...ext}><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.05 12.54a4.4 4.4 0 0 1 2.1-3.7 4.52 4.52 0 0 0-3.56-1.92c-1.5-.15-2.93.88-3.69.88-.77 0-1.94-.86-3.2-.84a4.73 4.73 0 0 0-3.98 2.42c-1.7 2.95-.43 7.31 1.22 9.71.81 1.17 1.78 2.49 3.05 2.44 1.22-.05 1.68-.79 3.16-.79 1.47 0 1.89.79 3.18.76 1.31-.02 2.14-1.19 2.94-2.37a10.6 10.6 0 0 0 1.34-2.74 4.27 4.27 0 0 1-2.56-3.85z"></path><path d="M14.6 5.3a4.33 4.33 0 0 0 1-3.1 4.41 4.41 0 0 0-2.9 1.5 4.13 4.13 0 0 0-1.03 3 3.65 3.65 0 0 0 2.93-1.4z"></path></svg> App Store</a>
            <a class="foot-app" href={M91_LINKS.googlePlay} {...ext}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.61 1.81a2.01 2.01 0 0 0-.61 1.43v17.52c0 .56.23 1.06.61 1.43L13.79 12 3.61 1.81z" fill="#00A0FF"></path><path d="M17.14 15.34 13.79 12l3.35-3.34 4 2.27c1.14.65 1.14 1.79 0 2.44l-4 2.27z" fill="#FFCE00"></path><path d="M17.14 15.34 13.79 12 3.61 22.19c.38.4 1 .45 1.7.05l11.83-6.9z" fill="#FF3A44"></path><path d="M17.14 8.66 5.31 1.76c-.7-.4-1.32-.35-1.7.05L13.79 12l3.35-3.34z" fill="#00D267"></path></svg> Google Play</a>
          </span>
        </div>
        <nav aria-label="Product">
          <p class="foot-col-t">Product</p>
          {product.map((l) => <a class="foot-link" href={l.href}>{l.label}</a>)}
        </nav>
        <nav aria-label="For builders">
          <p class="foot-col-t">For builders</p>
          <a class="foot-link" href={M91_LINKS.docs}>Documentation</a>
          <a class="foot-link" href={M91_LINKS.llms} {...ext}><code>llms.txt</code><span class="foot-tag">FOR AI</span></a>
          <a class="foot-link" href={M91_LINKS.skill} {...ext}>Agent skill</a>
          <a class="foot-link" href={url('/rss.xml')}>Blog RSS</a>
        </nav>
        <nav aria-label="Company">
          <p class="foot-col-t">Company</p>
          <a class="foot-link" href={M91_LINKS.contact}>Contact</a>
          <a class="foot-link" href={M91_LINKS.msg91} {...ext}>MSG91</a>
          <a class="foot-link" href={M91_LINKS.abuse}>Report abuse</a>
        </nav>
      </div>
    </div>
    <div class="foot-bottom">
      <span>{year} M91 · Free forever · Built by MSG91</span>
      <span class="foot-legal">
        <a href={M91_LINKS.terms} {...ext}>Terms</a>
        <a href={M91_LINKS.privacy} {...ext}>Privacy</a>
        <a href={M91_LINKS.antiSpam} {...ext}>Anti-spam</a>
      </span>
    </div>
  </div>
</footer>

<script>
  // Copy setup prompt: copies the M91 site's prompt, then says "Copied" for two seconds.
  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-copy-prompt]')) {
    const label = btn.querySelector('[data-copy-label]')
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copyPrompt ?? '')
        btn.classList.add('is-done')
        if (label) label.textContent = 'Copied'
      } catch {
        if (label) label.textContent = 'Copy failed: select it on llms.txt'
      }
      setTimeout(() => {
        btn.classList.remove('is-done')
        if (label) label.textContent = 'Copy setup prompt'
      }, 2000)
    })
  }
</script>
