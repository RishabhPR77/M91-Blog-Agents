---
import Logo from './Logo.astro'
import { M91_URL } from '../config/site'
import { url } from '../lib/posts'
const year = new Date().getFullYear()
---
<footer class="mt-24 border-t border-line bg-bg-2">
  <div class="shell flex flex-col gap-8 py-12 md:flex-row md:items-start md:justify-between">
    <div class="max-w-sm">
      <a href={M91_URL} class="flex items-center gap-2 font-bold" aria-label="M91 home"><Logo size={24} /> M91</a>
      <p class="mt-3 text-sm text-fg-2">Alerts that reach a real human and keep going until somebody answers.</p>
    </div>
    <nav aria-label="Footer">
      <ul class="grid grid-cols-2 gap-x-10 gap-y-2 text-sm">
        <li><a href={M91_URL} class="hover:underline">M91 home</a></li>
        <li><a href={new URL('#how', M91_URL).href} class="hover:underline">How M91 works</a></li>
        <li><a href={new URL('#cases', M91_URL).href} class="hover:underline">Use cases</a></li>
        <li><a href={url('/')} class="hover:underline">Blog</a></li>
        <li><a href={url('/rss.xml')} class="hover:underline">RSS feed</a></li>
        <li><a href={url('/llms.txt')} class="hover:underline">llms.txt</a></li>
      </ul>
    </nav>
  </div>
  <div class="shell border-t border-line py-5 text-sm text-fg-2">© {year} M91 by MSG91</div>
</footer>
