---
// Small inline icons for the blocks (decorative: always aria-hidden). 20×20, currentColor.
interface Props { name: 'info' | 'tip' | 'warning' | 'agent' | 'm91' | 'phone' | 'human' | 'software'; class?: string }
const { name, class: cls = '' } = Astro.props
---
<svg class={`block-icon ${cls}`} width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'info' && <><circle cx="10" cy="10" r="7.5" /><path d="M10 9v5M10 6.2v.1" /></>}
  {name === 'tip' && <><path d="M7.5 15h5M8.2 17.5h3.6" /><path d="M10 2.5a5 5 0 0 0-3 9c.6.5 1 1.2 1 2V14h4v-.5c0-.8.4-1.5 1-2a5 5 0 0 0-3-9Z" /></>}
  {name === 'warning' && <><path d="M10 2.8 1.9 16.5h16.2L10 2.8Z" /><path d="M10 8v4M10 14.4v.1" /></>}
  {name === 'agent' && <><rect x="4" y="6" width="12" height="10" rx="2.5" /><path d="M10 3v3M7.5 10.5v.1M12.5 10.5v.1M8 13.5h4" /></>}
  {name === 'm91' && <><path d="M4 7V4h3M16 7V4h-3M4 13v3h3M16 13v3h-3" /><circle cx="10" cy="10" r="1.6" /></>}
  {name === 'phone' && <><rect x="5.5" y="2.5" width="9" height="15" rx="2" /><path d="M9 15h2" /></>}
  {name === 'human' && <><circle cx="10" cy="6.5" r="3" /><path d="M3.5 17a6.5 6.5 0 0 1 13 0" /></>}
  {name === 'software' && <><circle cx="10" cy="10" r="2.6" /><path d="M10 2.5v2M10 15.5v2M2.5 10h2M15.5 10h2M4.7 4.7l1.4 1.4M13.9 13.9l1.4 1.4M4.7 15.3l1.4-1.4M13.9 6.1l1.4-1.4" /></>}
</svg>
