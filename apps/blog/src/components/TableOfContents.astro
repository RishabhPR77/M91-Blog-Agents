---
import type { Heading } from '../lib/markdown'
interface Props { headings: Heading[] }
const h2s = Astro.props.headings.filter((h) => h.depth === 2 && h.id)
---
{h2s.length >= 4 && (
  <nav aria-labelledby="toc-title" class="rounded-2xl border border-line p-5">
    <h2 id="toc-title" class="text-sm font-bold uppercase tracking-wider text-fg-2">On this page</h2>
    <ol class="mt-3 space-y-1.5 text-[0.95rem]">
      {h2s.map((h) => <li><a href={`#${h.id}`} class="hover:underline">{h.text}</a></li>)}
    </ol>
  </nav>
)}
