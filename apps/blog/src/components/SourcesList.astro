---
interface Props { sources: { url: string; title: string }[] }
const { sources } = Astro.props
const host = (u: string) => { try { return new URL(u).host } catch { return u } }
---
{sources.length > 0 && (
  <section aria-labelledby="sources-title">
    <h2 id="sources-title" class="mono-k">Sources</h2>
    <ol class="mt-3 list-decimal space-y-2 pl-5 text-[15px] text-fg-2">
      {sources.map((s) => (
        <li><a href={s.url} target="_blank" rel="noopener noreferrer" class="text-fg underline underline-offset-2">{s.title || host(s.url)}</a> <span class="text-sm">({host(s.url)})</span></li>
      ))}
    </ol>
  </section>
)}
