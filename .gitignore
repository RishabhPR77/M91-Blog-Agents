# Secrets — never commit (any folder). The template is env.example (no leading dot), which is committed.
.env
.env.*
**/.env
**/.env.*

# Dependencies / build
node_modules/
npm-debug.log*
coverage/
apps/engine/dashboard/dist/
# Exported drafts for reading (npm run draft -- --export …)
drafts/
# The blog: build output, Astro's cache, and the post files the Publisher writes (build input only; Mem0 is the source of truth)
apps/blog/dist/
apps/blog/.astro/
apps/blog/src/content/posts/*.json
apps/blog/test/.tmp/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local Claude settings (personal)
.claude/settings.local.json

# Local preview servers for the Browser pane (machine-specific)
.claude/launch.json
