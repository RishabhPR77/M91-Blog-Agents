# M91 Blog Engine v2: every key read by apps/engine/src/config.js.
# Copy to .env at the repo root and fill in the empty values. Never commit .env.
# Keep comments on their own lines (no "KEY=value  # note").
# Keys that have a default work without a line here; the line is shown so it can be overridden.

# --- viaSocket (embed token: HS256 over org_id, project_id, unique_identifier) ---
VIASOCKET_ORG_ID=
VIASOCKET_PROJECT_ID=
VIASOCKET_EMBED_SECRET=
VIASOCKET_API_BASE=https://flow-api.viasocket.com/
VIASOCKET_SYSTEM_USER_ID=m91-blog-engine
# AI call tuning: rtlayer wait, history poll interval, HTTP retries per call (429/500/502)
AI_RTLAYER_TIMEOUT_MS=300000
AI_POLL_INTERVAL_MS=3000
AI_MAX_RETRIES=3

# --- Per-agent AI settings (service: openai | anthropic | gemini; delivery: sync | rtlayer) ---
SCOUT_AI_SERVICE=openai
SCOUT_AI_MODEL=gpt-5-mini
SCOUT_DELIVERY=sync
STRATEGIST_AI_SERVICE=openai
STRATEGIST_AI_MODEL=gpt-5.6-luna
STRATEGIST_DELIVERY=sync
WRITER_AI_SERVICE=gemini
WRITER_AI_MODEL=gemini-2.5-flash
WRITER_DELIVERY=rtlayer
# Optional fallback for the Writer: set both or neither (one attempt after the main model fails twice)
WRITER_FALLBACK_SERVICE=
WRITER_FALLBACK_MODEL=
# Writer: repair calls when a draft fails the hard checks (not Reviewer revisions)
WRITER_MAX_REPAIRS=1
# What a revision sees of the previous draft: context | full
WRITER_REVISION_INPUT=context
# Doc text given to the Writer for a tutorial (at most 48000: viaSocket caps a message at 50,000)
TUTORIAL_SOURCE_MAX_CHARS=40000
# true = post every draft to Slack in parts while testing
SLACK_POST_DRAFTS=false
REVIEWER_AI_SERVICE=openai
REVIEWER_AI_MODEL=gpt-5.5
REVIEWER_DELIVERY=rtlayer
# Temporary until the real Reviewer (Phase 5): pass | fail_once | fail_always
REVIEWER_STUB_MODE=pass
# Max allowed URLs the Reviewer may open per review (the prompt says so; code warns if exceeded)
REVIEWER_MAX_SOURCE_CHECKS=5
# Max feedback items in a review and passed to a revision
REVIEW_FEEDBACK_MAX_ITEMS=8
# Max lessons saved per review
LESSONS_PER_REVIEW_MAX=3
PROMO_AI_SERVICE=openai
PROMO_AI_MODEL=gpt-5-mini
PROMO_DELIVERY=sync
# Designer agent (used from Phase 8)
DESIGNER_AI_SERVICE=openai
DESIGNER_AI_MODEL=gpt-5.6-luna
DESIGNER_DELIVERY=rtlayer

# --- Mem0 hosted Platform (MEM0_ORG_ID / MEM0_PROJECT_ID are unused: the API key is project-scoped) ---
MEM0_API_KEY=
MEM0_ORG_ID=
MEM0_PROJECT_ID=
MEM0_AGENT_ID=m91-blog

# --- Notifications (two viaSocket webhook flows; see apps/engine/docs/SETUP_FLOWS.md) ---
SLACK_POST_WEBHOOK_URL=
M91_ALERT_WEBHOOK_URL=
WEBHOOK_SHARED_KEY=
# Max characters per Slack message part (long posts are split by paragraph)
SLACK_CHUNK_CHARS=2800

# --- M91 product ---
M91_DOCS_URL=https://m91.msg91.com/llms.txt
# Comma-separated hosts; only doc links on these are fetched
M91_DOCS_HOSTS=m91.msg91.com
M91_SKILL_REPO_URL=https://github.com/MSG91/m91-skill
M91_CTA_URL=

# --- Quality gates and loop limits ---
PASS_SCORE_MIN=85
PASS_AREA_MIN=7
MAX_WRITER_REVISIONS=2
MAX_STRATEGIST_REBRIEFS=1
MAX_SCOUT_RETRIES=1
MAX_AI_ROUNDS_PER_POST=5

# --- Content ---
TARGET_WORDS_MIN=700
TARGET_WORDS_MAX=1500
DEFAULT_TONE=friendly-teacher
TIMEZONE=Asia/Kolkata
READING_GRADE_INTRO_MAX=6
READING_GRADE_POST_MAX=8
# A draft fails the hard checks when its whole-post grade is more than this above READING_GRADE_POST_MAX
READING_GRADE_HARD_MARGIN=2
# ...or when its word count is more than this % outside TARGET_WORDS_MIN–TARGET_WORDS_MAX
WORDS_HARD_MARGIN_PCT=20
COMPETITORS=withHuman, PagerDuty, Opsgenie, Twilio A2H, Pushover

# --- Scout ---
SCOUT_RESEARCH_DELIVERY=rtlayer
SCOUT_MAX_CALLS=14
SCOUT_REUSE_HOURS=24
SCOUT_MIN_OPEN_CLUSTERS=5
SCOUT_QUESTIONS_PER_GROUP=8
# Topic groups that get a question search (fewer = fewer AI credits)
SCOUT_QUESTION_GROUPS=1,2,3,4,5
STORY_LOOKBACK_DAYS=30
RAPID_RESPONSE_DAYS=7
STYLE_REUSE_DAYS=14
DOCS_MAX_PAGES=15
# At most 48000: viaSocket refuses a message over 50,000 characters
DOCS_MAX_CHARS=45000
DEDUPE_SIMILARITY=0.85
URL_CHECK_TIMEOUT_MS=10000

# --- Strategist ---
STRATEGIST_MAX_REPAIRS=1
RECENT_BRIEFS_WINDOW=10
TITLE_MAX_CHARS=70
OUTLINE_MIN_SECTIONS=4
OUTLINE_MAX_SECTIONS=8
MIN_QUESTION_HEADINGS=3
LESSONS_LIMIT=5
ALLOW_UPDATE_BRIEFS=false

# --- Runtime ---
AUTO_PUBLISH=false
DRY_RUN=false
LOG_LEVEL=info
# Engine API port; POST /run needs x-trigger-key = PIPELINE_TRIGGER_KEY (at least 16 characters)
PORT=8080
PIPELINE_TRIGGER_KEY=

# --- Dashboard (the Phase 6 dashboard dev server runs on DASHBOARD_PORT and proxies /api to PORT) ---
DASHBOARD_PORT=5173
# false = API on 127.0.0.1 only, no login. true = login with DASHBOARD_PASSWORD.
DASHBOARD_AUTH=false
DASHBOARD_PASSWORD=

# --- Blog + Embarko (used from Phase 7) ---
BLOG_APP_NAME=m91-blog
BLOG_BASE_URL=https://m91-blog.embarko.app
EMBARKO_DEPLOY_TOKEN=
NOINDEX_FIRST_N_POSTS=10
