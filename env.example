# M91 Blog Engine v2: every key read by apps/engine/src/config.js.
# Copy to .env at the repo root and fill in the empty values. Never commit .env.
# Keep comments on their own lines (no "KEY=value  # note").
# Keys that have a default work without a line here; the line is shown so it can be overridden.

# --- viaSocket (embed token: HS256 over org_id, project_id, unique_identifier) ---
VIASOCKET_ORG_ID=
VIASOCKET_PROJECT_ID=
VIASOCKET_EMBED_SECRET=
VIASOCKET_API_BASE=https://flow-api.viasocket.com/
VIASOCKET_SYSTEM_USER_ID=m91-blog-engine
# AI call tuning: rtlayer wait, history poll interval, HTTP retries per call (429/500/502)
AI_RTLAYER_TIMEOUT_MS=300000
AI_POLL_INTERVAL_MS=3000
AI_MAX_RETRIES=3

# --- Per-agent AI settings (service: openai | anthropic | gemini; delivery: sync | rtlayer) ---
SCOUT_AI_SERVICE=openai
SCOUT_AI_MODEL=gpt-5-mini
SCOUT_DELIVERY=sync
STRATEGIST_AI_SERVICE=openai
STRATEGIST_AI_MODEL=gpt-5.6-luna
STRATEGIST_DELIVERY=sync
WRITER_AI_SERVICE=gemini
WRITER_AI_MODEL=gemini-2.5-flash
WRITER_DELIVERY=rtlayer
# Optional fallback for the Writer: set both or neither (one attempt after the main model fails twice)
WRITER_FALLBACK_SERVICE=
WRITER_FALLBACK_MODEL=
# Writer: repair calls when a draft fails the hard checks (not Reviewer revisions)
WRITER_MAX_REPAIRS=1
# What a revision sees of the previous draft: full (the whole draft, so it changes only what was flagged) | context (a summary)
WRITER_REVISION_INPUT=full
# Doc text given to the Writer for a tutorial (at most 48000: viaSocket caps a message at 50,000)
TUTORIAL_SOURCE_MAX_CHARS=40000
# true = post every draft to Slack in parts while testing
SLACK_POST_DRAFTS=false
REVIEWER_AI_SERVICE=openai
REVIEWER_AI_MODEL=gpt-5.5
REVIEWER_DELIVERY=rtlayer
# Max allowed URLs the Reviewer may open per review (the prompt says so; code warns if exceeded)
REVIEWER_MAX_SOURCE_CHECKS=5
# Max feedback items in a review and passed to a revision
REVIEW_FEEDBACK_MAX_ITEMS=8
# Max lessons saved per review
LESSONS_PER_REVIEW_MAX=3
# Roadmap Planner (Phase 12): plans the learning path in one call; one repair when the code checks fail
PLANNER_AI_SERVICE=openai
PLANNER_AI_MODEL=gpt-5.6-luna
PLANNER_DELIVERY=sync
PLANNER_MAX_REPAIRS=1
# Runs follow the approved roadmap (pinned topics first, then a timely post you chose with Write now)
ROADMAP_ENABLED=true
# The timely lane next to the roadmap: news checks propose timely opportunities, you decide (Write now / Add to
# roadmap / Dismiss). true: on (needs ROADMAP_ENABLED=true)
RAPID_RESPONSE_ENABLED=true
# Check the news at the start of every full run (1 AI call), and how far back an event may be (cards expire after
# that many days from the event's date)
TIMELY_CHECK_ON_RUN=true

# --- The editor: what the next run writes. editor = a fresh news story when no news post went out in the last
# NEXT_NEWS_GAP_DAYS days, a tutorial when none of the last NEXT_TUTORIAL_EVERY - 1 posts was one, otherwise the next
# roadmap slot; never a topic too close (NEXT_SIMILARITY) to a published guide or another post. roadmap = always the
# next slot. Pinned topics and Write now cards always go first. No AI calls. ---
NEXT_PICK=editor
NEXT_SIMILARITY=0.6
NEXT_NEWS_GAP_DAYS=7
NEXT_TUTORIAL_EVERY=3

# --- Published guides (msg91.com/guide): the M91 posts already live. Read before each full run (no AI; 1 Mem0 add per
# new guide). The roadmap skips topics they cover, the knowledge map lists them, and posts may link them. ---
GUIDES_SYNC_ON_RUN=true
GUIDES_FEED_URL=https://msg91.com/guide/feed.xml
GUIDES_LIST_URL=https://msg91.com/guide
GUIDES_MAX_PAGES=12
GUIDES_TIMEOUT_MS=15000
TIMELY_WINDOW_DAYS=7
# At most this many timely posts per 7 days (more wait, and the dashboard says why)
TIMELY_MAX_PER_WEEK=1
PROMO_AI_SERVICE=openai
PROMO_AI_MODEL=gpt-5-mini
PROMO_DELIVERY=sync
# LinkedIn post limit and the per-post limit in the X thread (promo pack)
PROMO_LINKEDIN_MAX_CHARS=1300
PROMO_X_POST_MAX_CHARS=270
# Phase 10: the promo pack is off (its code stays); true runs it again when a draft is approved
PROMO_ENABLED=false
# Phase 11 (fallback): the Experience Designer is off. false: no guide, no "Change the design", and the Reviewer
# uses the pre-Phase-10 areas and weights. true turns Phase 10 back on
EXPERIENCE_ENABLED=false
# Phase 11: where an approved post goes. none: nowhere (the Markdown export is the output; no blog build, no
# Embarko); embarko: the Phase 7 blog; docstar: Docstar (answers "not configured" until the DOCSTAR_* keys are set)
PUBLISH_TARGET=none
# Phase 11: folder for the final Markdown exports (empty: apps/engine/exports, gitignored)
EXPORT_DIR=
# Phase 11: Docstar. DOCSTAR_API_URL is https://api.docstar.io; the API key is a secret (Docstar tokens start with hm_)
DOCSTAR_API_URL=
DOCSTAR_API_KEY=
DOCSTAR_COLLECTION_ID=
# Your Docstar workspace (org) id: every page request names it. Not a secret (POST https://api.docstar.io/proxy/decode-token
# with the key returns it as orgDetails.id)
DOCSTAR_ORG_ID=
# Experience Designer (Phase 10): turns each draft into an interactive guide before the Reviewer; writes short
# interface text only. A long structured answer: rtlayer
EXPERIENCE_AI_SERVICE=anthropic
EXPERIENCE_AI_MODEL=claude-sonnet-4-6
EXPERIENCE_DELIVERY=rtlayer
# Repair calls when the answer breaks a rule, and the most designed components per guide (prose doesn't count)
EXPERIENCE_MAX_REPAIRS=1
EXPERIENCE_MAX_COMPONENTS=10
# New drafts get a guide (each post can be switched off in the dashboard)
INTERACTIVE_DEFAULT=true

# --- Mem0 hosted Platform (MEM0_ORG_ID / MEM0_PROJECT_ID are unused: the API key is project-scoped) ---
MEM0_API_KEY=
MEM0_ORG_ID=
MEM0_PROJECT_ID=
# Mem0 read cache lifetime in ms (per process; writes clear it). 0 turns it off
STORE_CACHE_TTL_MS=30000
# Where a run's work in progress lives: local (work.json in the engine's data folder; an approved post is copied to Mem0) or mem0 (every step in Mem0, as before)
WORK_STORE=local
# Days the local work of a rejected or failed post (and old local run records) is kept
WORK_KEEP_DAYS=7
MEM0_AGENT_ID=m91-blog
# Phase 9: Mem0 quota guard. Your plan's monthly request limit; a dashboard warning from MEM0_WARN_PCT, new runs paused from MEM0_STOP_PCT (an estimate: the Mem0 console has the exact figure)
# Retrievals (reads + searches) count against MEM0_MONTHLY_LIMIT; adds (writes) against MEM0_MONTHLY_ADD_LIMIT
MEM0_MONTHLY_LIMIT=1000
MEM0_MONTHLY_ADD_LIMIT=10000
MEM0_WARN_PCT=80
MEM0_STOP_PCT=95

# --- Notifications (two viaSocket webhook flows; see apps/engine/docs/SETUP_FLOWS.md) ---
SLACK_POST_WEBHOOK_URL=
M91_ALERT_WEBHOOK_URL=
WEBHOOK_SHARED_KEY=
# Max characters per Slack message part (long posts are split by paragraph)
SLACK_CHUNK_CHARS=2800
# true = post the full approved post to Slack (in numbered parts)
SLACK_POST_APPROVED=true

# --- M91 product ---
M91_DOCS_URL=https://m91-api.msg91.com/llms.txt
# Comma-separated hosts; only doc links on these are fetched
M91_DOCS_HOSTS=m91-api.msg91.com,m91.msg91.com
M91_SKILL_REPO_URL=https://github.com/MSG91/m91-skill
M91_CTA_URL=

# --- Quality gates and loop limits ---
PASS_SCORE_MIN=80
PASS_AREA_MIN=6
# Only a major problem (a failed AI gate, a contradicting source, a major hard check) or a total below this score sends
# the post back to the Writer. Otherwise it goes to you as "pass with notes", the minor items listed as "should fix"
REVISE_BELOW_SCORE=70
MAX_WRITER_REVISIONS=2
# Re-runs of the Experience Designer alone, when the Reviewer's must-fix items are only about the design
MAX_DESIGNER_REVISIONS=2
MAX_STRATEGIST_REBRIEFS=1
MAX_SCOUT_RETRIES=1
MAX_AI_ROUNDS_PER_POST=5
# Human approval gate: max counter prompts per brief; re-run checks + Reviewer after one; M91 alert when a draft waits
MAX_HUMAN_REVISIONS=5
REREVIEW_AFTER_HUMAN=true
M91_NOTIFY_ON_AWAITING=false
# true = allow TEST-ONLY CLI commands such as npm run test:await (never through the API)
ALLOW_TEST_COMMANDS=false

# --- Content ---
TARGET_WORDS_MIN=1200
TARGET_WORDS_MAX=2000
DEFAULT_TONE=friendly-teacher
TIMEZONE=Asia/Kolkata
READING_GRADE_INTRO_MAX=6
READING_GRADE_POST_MAX=7
# The two grades above are targets (soft). A draft fails the hard checks when its post grade is more than this above
# READING_GRADE_POST_MAX (hard limit 8) or its intro grade more than this above READING_GRADE_INTRO_MAX (hard limit 7).
READING_GRADE_HARD_MARGIN=1
# Phase 12: a sentence over SENTENCE_HARD_MAX_WORDS or a paragraph over PARAGRAPH_MAX_SENTENCES fails the hard checks;
# sentences of SENTENCE_MAX_WORDS+1 to SENTENCE_HARD_MAX_WORDS words are listed for the Reviewer
SENTENCE_MAX_WORDS=20
SENTENCE_HARD_MAX_WORDS=25
PARAGRAPH_MAX_SENTENCES=3
# ...or when its word count is more than this % outside TARGET_WORDS_MIN–TARGET_WORDS_MAX
WORDS_HARD_MARGIN_PCT=20
COMPETITORS=withHuman, PagerDuty, Opsgenie, Twilio A2H, Pushover

# --- Scout ---
SCOUT_RESEARCH_DELIVERY=rtlayer
SCOUT_MAX_CALLS=14
SCOUT_REUSE_HOURS=24
SCOUT_MIN_OPEN_CLUSTERS=5
# Phase 9: the Scout's stories call waits this long for its answer (ms); a timeout is a warning, not a failure
SCOUT_STORIES_TIMEOUT_MS=480000
# The Scout's question groups, stories and tutorials run at the same time, at most this many (1 = one after another)
SCOUT_CONCURRENCY=7
# How long each question group's web search may take (ms); a timeout is a warning
SCOUT_QUESTIONS_TIMEOUT_MS=420000
SCOUT_QUESTIONS_PER_GROUP=8
# Topic groups that get a question search (fewer = fewer AI credits)
SCOUT_QUESTION_GROUPS=1,2,3,4,5
STORY_LOOKBACK_DAYS=30
RAPID_RESPONSE_DAYS=7
STYLE_REUSE_DAYS=14
DOCS_MAX_PAGES=15
# At most 48000: viaSocket refuses a message over 50,000 characters
DOCS_MAX_CHARS=45000
DEDUPE_SIMILARITY=0.85
# Phase 9: duplicate checks in memory (local, trigram similarity against lists the run already read) or with a Mem0 search (mem0, one request per check; uses DEDUPE_SIMILARITY)
DEDUPE_MODE=local
DEDUPE_SIMILARITY_LOCAL=0.65
URL_CHECK_TIMEOUT_MS=10000

# --- Strategist ---
STRATEGIST_MAX_REPAIRS=1
RECENT_BRIEFS_WINDOW=10
TITLE_MAX_CHARS=70
# Max words in a brief's main keyword (a long keyword makes a simple opening impossible)
KEYWORD_MAX_WORDS=6
OUTLINE_MIN_SECTIONS=4
OUTLINE_MAX_SECTIONS=10
MIN_QUESTION_HEADINGS=3
LESSONS_LIMIT=5
ALLOW_UPDATE_BRIEFS=false

# --- Runtime ---
AUTO_PUBLISH=false
DRY_RUN=false
LOG_LEVEL=info
# Phase 9: the engine's local data folder (empty = apps/engine/data; run lock and Mem0 usage, never content)
ENGINE_DATA_DIR=
# A run lock whose heartbeat is older than this (minutes), or whose process is gone, is taken over
RUN_LOCK_STALE_MIN=10
# Engine API port; POST /run needs x-trigger-key = PIPELINE_TRIGGER_KEY (at least 16 characters)
PORT=8080
PIPELINE_TRIGGER_KEY=

# --- Dashboard (the Phase 6 dashboard dev server runs on DASHBOARD_PORT and proxies /api to PORT) ---
DASHBOARD_PORT=5173
# false = API on 127.0.0.1 only, no login. true = login with DASHBOARD_PASSWORD.
DASHBOARD_AUTH=false
DASHBOARD_PASSWORD=
# Admin login (always on when hosted on Embarko, and used instead of DASHBOARD_PASSWORD whenever both are set).
# ADMIN_PASSWORD_HASH comes from `npm run admin:hash` in apps/engine (the plain password is never stored).
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# --- Blog + Embarko (used from Phase 7) ---
BLOG_APP_NAME=m91-blog
BLOG_BASE_URL=https://m91-blog.embarko.app
EMBARKO_DEPLOY_TOKEN=
NOINDEX_FIRST_N_POSTS=10
# Publisher (Phase 7): Embarko deploy API, the name sent as X-Agent-Name, blog build and live-check limits (ms)
EMBARKO_API_BASE=https://ship.embarko.ai
EMBARKO_AGENT_NAME=m91-blog-engine
BLOG_BUILD_TIMEOUT_MS=300000
PUBLISH_VERIFY_TIMEOUT_MS=120000
