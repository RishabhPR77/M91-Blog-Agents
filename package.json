{
  "name": "m91-blog-engine",
  "private": true,
  "description": "M91 Blog Engine v2: engine app, blog app and shared content package",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/engine",
    "packages/*"
  ],
  "scripts": {
    "install:dashboard": "npm run install:dashboard --workspace @m91/engine",
    "install:blog": "npm --prefix apps/blog ci",
    "dev:engine": "npm run dev --workspace @m91/engine",
    "dev:blog": "npm --prefix apps/blog run dev",
    "build:blog": "npm --prefix apps/blog run build",
    "test": "npm test --workspaces --if-present && npm run test:blog",
    "test:blog": "npm --prefix apps/blog test",
    "check": "npm run check --workspace @m91/engine"
  },
  "overrides": {
    "shell-quote": "1.11.0"
  }
}
