{
  "name": "m91-blog-engine",
  "private": true,
  "description": "M91 Blog Engine v2: engine app, blog app and shared content package",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:engine": "npm run dev --workspace @m91/engine",
    "test": "npm test --workspaces --if-present",
    "check": "npm run check --workspace @m91/engine"
  },
  "overrides": {
    "shell-quote": "1.11.0"
  }
}
